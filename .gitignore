# Standard Unity .gitignore.
# Rule: ignore only generated output. Everything needed to rebuild (Assets, Packages/manifest.json,
# Packages/packages-lock.json, ProjectSettings) stays tracked.

# Generated by Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
*.apk
*.aab
*.unitypackage
*.app

# Generated by IDEs / build tools (Visual Studio project files are regenerated by Unity)
.vs/
.idea/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Per-machine tool settings (may contain local paths or secrets)
.claude/settings.local.json
/.utmp/

# Misc
*.tmp
*.logcat
sysinfo.txt
crashlytics-build.properties

# Local scratch screenshots and debug images (not part of the project)
/overlap.png
